# Konfigurasi Backend & Frontend HERB-INFO AI
# Salin file ini menjadi .env dan isi GEMINI_API_KEY Anda

# URL API Backend yang digunakan oleh Frontend Vite
VITE_API_BASE_URL=http://localhost:8000

# Pengaturan Backend FastAPI
HERB_DB_PATH=data/processed/herb_info.db
HERB_INCOMING_DIR=data/incoming
HERB_PROCESSED_DIR=data/processed
HERB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Konfigurasi Google Gemini API (Untuk Diagnosis Gejala, Rekomendasi Dosis & Pencarian Semantik)
GEMINI_API_KEY=masukkan_gemini_api_key_anda_di_sini
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
HERB_ENABLE_SEMANTIC_MODEL=true
HERB_ALLOW_UNSAFE_JOBLIB=false
